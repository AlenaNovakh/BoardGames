<Window x:Class="BoardGames.WPF.GameDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали игры"
        Width="620" Height="420"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="#BDBDBD"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,12,0">
            <Image x:Name="imgCover"
                   Stretch="Uniform"
                   VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Column="1">

            <TextBlock x:Name="lblName"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Border x:Name="borderType"
                    Background="#E3F2FD"
                    CornerRadius="4"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12">
                <TextBlock x:Name="lblType"
                           FontSize="13"
                           Foreground="#1565C0"
                           FontWeight="SemiBold"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Игроков:"
                           Foreground="#757575" FontSize="13" Margin="0,4"/>
                <TextBlock x:Name="lblPlayers"
                           Grid.Row="0" Grid.Column="1"
                           FontSize="13" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Возраст:"
                           Foreground="#757575" FontSize="13" Margin="0,4"/>
                <TextBlock x:Name="lblAge"
                           Grid.Row="1" Grid.Column="1"
                           FontSize="13" Margin="0,4"/>

                <TextBlock x:Name="lblExtraKey"
                           Grid.Row="2" Grid.Column="0"
                           Foreground="#757575" FontSize="13" Margin="0,4"/>
                <TextBlock x:Name="lblExtraValue"
                           Grid.Row="2" Grid.Column="1"
                           FontSize="13" Foreground="#1565C0" Margin="0,4"/>
            </Grid>

            <Separator Margin="0,12"/>

            <TextBlock Text="Описание"
                       FontSize="13"
                       Foreground="#757575"
                       Margin="0,0,0,4"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                <TextBlock x:Name="lblDescription"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="20"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>