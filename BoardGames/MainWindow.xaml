<Window x:Class="BoardGames.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardGames — Каталог настольных игр"
        Width="560" Height="380"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Label Content="Выберите игру:" Width="120"/>

            <ComboBox x:Name="cmbGames"
                      Width="260"
                      SelectionChanged="cmbGames_SelectionChanged"
                      DisplayMemberPath="Name"/>

            <Button x:Name="btnShowDetails"
                    Content="Показать данные"
                    IsEnabled="False"
                    Click="btnShowDetails_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Открыть каталог" Click="btnOpenCatalog_Click"/>
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,0,0,12"/>

        <GroupBox Grid.Row="3" Header="Аналитика каталога" Padding="8">
            <UniformGrid Columns="2">
                <TextBlock x:Name="lblTotalGames"  Margin="4,4,4,4" FontSize="13"/>
                <TextBlock x:Name="lblMeanAge"     Margin="4,4,4,4" FontSize="13"/>
                <TextBlock x:Name="lblAvgMin"      Margin="4,4,4,4" FontSize="13"/>
                <TextBlock x:Name="lblAvgMax"      Margin="4,4,4,4" FontSize="13"/>
                <TextBlock x:Name="lblMeanRange"   Margin="4,4,4,4" FontSize="13"/>
            </UniformGrid>
        </GroupBox>
    </Grid>
</Window>